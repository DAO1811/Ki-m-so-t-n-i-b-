# Ví dụ, không đặt thông tin bí mật thật trong Git.
DEBUG=0
SECRET_KEY=replace-with-a-long-random-secret-in-hosting-settings
ALLOWED_HOSTS=your-app.example.com
CSRF_TRUSTED_ORIGINS=https://your-app.example.com
# Nhập URL PostgreSQL tại phần biến môi trường của dịch vụ triển khai.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Hồ sơ công ty: chỉ mục trong PostgreSQL, tệp riêng tư trên Drive đã cấp OAuth.
PRIVATE_MEDIA_PROVIDER=drive
INVENTORY_COMPANY_NAME=DHD
GOOGLE_DRIVE_EXPECTED_FOLDER_ID=1ZR6b7rB5KJOh9LjSkoVIcFqEKHp5o0Mp
# Đặt giá trị thật trong Environment của hosting; xem docs/QR_STOCKTAKE_AND_DRIVE.md.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
