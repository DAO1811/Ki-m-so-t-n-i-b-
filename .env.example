# Ví dụ, không đặt thông tin bí mật thật trong Git.
DEBUG=0
SECRET_KEY=replace-with-a-long-random-secret-in-hosting-settings
ALLOWED_HOSTS=your-app.example.com
CSRF_TRUSTED_ORIGINS=https://your-app.example.com
# Nhập URL PostgreSQL tại phần biến môi trường của dịch vụ triển khai.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
