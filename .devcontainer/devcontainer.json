{
  "name": "DHD KSNB · Bản chạy thử",
  "dockerComposeFile": "compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/dhd-ksnb",
  "remoteUser": "vscode",
  "shutdownAction": "stopCompose",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {"label": "DHD · Dữ liệu thử", "onAutoForward": "openBrowser", "requireLocalPort": true}
  },
  "otherPortsAttributes": {"onAutoForward": "ignore"},
  "postCreateCommand": "python scripts/preview.py setup",
  "postStartCommand": "python scripts/preview.py start",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.debugpy", "charliermarsh.ruff"],
      "settings": {"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"}
    }
  }
}
